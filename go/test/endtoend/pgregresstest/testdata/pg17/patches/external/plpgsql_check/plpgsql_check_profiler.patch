# Known divergence, by design: multigateway rejects a dynamic EXECUTE inside a
# PL/pgSQL body because the runtime-built statement text cannot be vetted for
# unsafe session-state changes (see go/services/multigateway/planner/
# unsafe_funccall.go). The profiler test builds a function whose body runs
# EXECUTE 'update ' || t1 ..., so multigres rejects its CREATE where stock PG
# defers. The function never exists, so the profiler reads that follow
# (select f1(); plpgsql_profiler_function_tb('f1()')) report "does not exist".
# The rejection is the intended pooler behavior; the cascade is its consequence.
--- a
+++ b
@@ -139,6 +139,7 @@
 EXECUTE 'delete from ' || t1;
 end;
 $$ language plpgsql;
+ERROR: EXECUTE of a runtime-built statement inside a PL/pgSQL body is not supported: the statement text is not a constant, so it cannot be checked for unsafe session-state changes
 select plpgsql_profiler_reset_all();
 plpgsql_profiler_reset_all
 ----------------------------
@@ -152,24 +153,12 @@
 (1 row)
 
 select f1();
