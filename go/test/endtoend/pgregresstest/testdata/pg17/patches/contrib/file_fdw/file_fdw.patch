@@ -472,11 +472,10 @@
 SET ROLE regress_file_fdw_user;
 \t on
 SELECT explain_filter('EXPLAIN (VERBOSE, COSTS FALSE) SELECT * FROM agg_text WHERE a > 0');
-Foreign Scan on public.agg_text
-Output: a, b
-Filter: (agg_text.a > 0)
-Foreign File: .../agg.data
