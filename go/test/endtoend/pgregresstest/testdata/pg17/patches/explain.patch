# Known divergences (by design):
# - explain_filter / explain_filter_to_json run a dynamic EXECUTE the pooler
#   cannot vet, so their runtime CREATE is rejected. Both are pre-seeded on the
#   primary (testdata/pg17/regress_preseed.sql) so the EXPLAIN checks still run.
# - explain_filter('explain (memory) execute int8_query') additionally fails:
#   int8_query is prepared on one pooled backend, but the seeded function's
#   dynamic EXECUTE runs on another that has not prepared it.
# - CREATE FUNCTION pg_temp.mysin is rejected: creating objects in pg_temp via
#   schema qualification is not supported under connection pooling (PostgreSQL
#   has no CREATE TEMP FUNCTION spelling, so this concedes temporary functions).
#   The subsequent explain_filter over pg_temp.mysin then fails to resolve it;
#   the session-private pg_temp namespace also rules out preseeding.
--- a
+++ b
@@ -30,6 +30,7 @@
 end loop;
 end;
 $$;
+ERROR: EXECUTE of a runtime-built statement inside a PL/pgSQL body is not supported: the statement text is not a constant, so it cannot be checked for unsafe session-state changes
 -- To produce valid JSON output, replace numbers with "0" or "0.0" not "N"
 create function explain_filter_to_json(text) returns jsonb
 language plpgsql as
@@ -47,6 +48,7 @@
 return data::jsonb;
 end;
 $$;
+ERROR: EXECUTE of a runtime-built statement inside a PL/pgSQL body is not supported: the statement text is not a constant, so it cannot be checked for unsafe session-state changes
 -- Disable JIT, or we'll get different output on machines where that's been
 -- forced on
 set jit = off;
@@ -410,12 +412,8 @@

 prepare int8_query as select * from int8_tbl i8;
 select explain_filter('explain (memory) execute int8_query');
-explain_filter
----------------------------------------------------------
-Seq Scan on int8_tbl i8 (cost=N.N..N.N rows=N width=N)
-Memory: used=NkB allocated=NkB
-(2 rows)
-
+ERROR: prepared statement "int8_query" does not exist
+CONTEXT: PL/pgSQL function explain_filter(text) line 5 at FOR over EXECUTE statement
 -- Test EXPLAIN (GENERIC_PLAN) with partition pruning
 -- partitions should be pruned at plan time, based on constants,
 -- but there should be no pruning based on parameter placeholders
@@ -635,14 +633,14 @@
 create temp table t1(f1 float8);
 create function pg_temp.mysin(float8) returns float8 language plpgsql
 as 'begin return sin($1); end';
+ERROR: creating objects in pg_temp via schema qualification is not supported under connection pooling; use CREATE TEMP/TEMPORARY instead
 select explain_filter('explain (verbose) select * from t1 where pg_temp.mysin(f1) < 0.5');
