# Known divergence (by design): the eval() helper runs a dynamic EXECUTE the
# pooler cannot vet, so its runtime CREATE is rejected. It is pre-seeded on the
# primary (testdata/pg17/regress_preseed.sql) so the interval-arithmetic checks
# still run; only the rejected CREATE remains.
--- a
+++ b
@@ -1994,6 +1994,7 @@
 END
 $$
 LANGUAGE plpgsql;
+ERROR: EXECUTE of a runtime-built statement inside a PL/pgSQL body is not supported: the statement text is not a constant, so it cannot be checked for unsafe session-state changes
 SELECT d AS date, i AS interval,
 eval(format('date %L + interval %L', d, i)) AS plus,
 eval(format('date %L - interval %L', d, i)) AS minus
