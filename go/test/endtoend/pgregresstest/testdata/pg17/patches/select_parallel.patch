# Known divergences (by design):
# - SQL-level EXPLAIN EXECUTE substitutes each argument expression into the
#   prepared body verbatim, so a plan shows the argument call (e.g.
#   make_some_array(1, 2)) instead of the value PostgreSQL evaluates it to ({1,2}).
# - a DO block issues SET effective_io_concurrency, a session-state change the
#   pooler cannot track inside a body, so it is rejected. The rejection no longer
#   aborts the surrounding transaction, so the dependent parallel-plan checks
#   still run; only the rejected DO block remains.
--- a
+++ b
@@ -531,6 +531,7 @@
 SET effective_io_concurrency = 50;
 EXCEPTION WHEN invalid_parameter_value THEN
 END $$;
+ERROR: SET/RESET inside a PL/pgSQL body is not supported: it changes backend session state that the connection pooler cannot track
 set work_mem='64kB'; --set small work mem to force lossy pages
 explain (costs off)
 select count(*) from tenk1, tenk2 where tenk1.hundred > 1 and tenk2.thousand=0;
@@ -1261,11 +1262,11 @@
 PREPARE pstmt(text, int[]) AS SELECT * FROM fooarr WHERE f1 = $1 AND f2 = $2;
 EXPLAIN (COSTS OFF) EXECUTE pstmt('1', make_some_array(1,2));
 QUERY PLAN
-------------------------------------------------------------------
+---------------------------------------------------------------------
 Gather
 Workers Planned: 3
 -> Parallel Seq Scan on fooarr
-Filter: ((f1 = '1'::text) AND (f2 = '{1,2}'::integer[]))
+Filter: ((f1 = '1'::text) AND (f2 = make_some_array(1, 2)))
 (4 rows)
 
 EXECUTE pstmt('1', make_some_array(1,2));
