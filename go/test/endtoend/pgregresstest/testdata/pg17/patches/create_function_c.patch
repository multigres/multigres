# Known divergence (by design): multigateway rejects LOAD because loading a
# shared library into a pooled backend leaks state onto every client that
# later reuses it. The single rejection line is the only delta; the CREATE
# FUNCTION checks that follow are unaffected.
# See go/services/multigateway/planner/unsafe_stmt.go.
--- a
+++ b
@@ -14,6 +14,7 @@
 -- is checked in many other test scripts.)
 --
 LOAD :'regresslib';
+ERROR: LOAD is not supported: loading shared libraries is not permitted through the connection pooler
 -- Things that shouldn't work:
 CREATE FUNCTION test1 (int) RETURNS int LANGUAGE C
 AS 'nosuchfile';
