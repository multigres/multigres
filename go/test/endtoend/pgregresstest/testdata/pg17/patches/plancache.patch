# Known divergence: pg_prepared_statements plan counters stay at zero for SQL
# PREPARE names. EXECUTE runs against the pooler's consolidated ppstmt* entry
# (shared across sessions), so generic/custom plan counts accrue there; the
# client-visible alias exists on the backend for server-side dynamic EXECUTE
# but is not itself executed. Query results and plan-mode behavior match
# upstream — only these counter columns differ.
--- a
+++ b
@@ -305,7 +305,7 @@
 where name = 'test_mode_pp';
 name | generic_plans | custom_plans
 --------------+---------------+--------------
-test_mode_pp | 0 | 1
+test_mode_pp | 0 | 0
 (1 row)
 
 -- force generic plan
@@ -322,7 +322,7 @@
 where name = 'test_mode_pp';
 name | generic_plans | custom_plans
 --------------+---------------+--------------
-test_mode_pp | 1 | 1
+test_mode_pp | 0 | 0
 (1 row)
 
 -- get to generic plan by 5 executions
@@ -355,7 +355,7 @@
 where name = 'test_mode_pp';
 name | generic_plans | custom_plans
 --------------+---------------+--------------
-test_mode_pp | 1 | 5
+test_mode_pp | 0 | 0
 (1 row)
 
 execute test_mode_pp(1); -- 5x
@@ -368,7 +368,7 @@
 where name = 'test_mode_pp';
 name | generic_plans | custom_plans
 --------------+---------------+--------------
-test_mode_pp | 2 | 5
+test_mode_pp | 0 | 0
 (1 row)
 
 -- we should now get a really bad plan
@@ -394,7 +394,7 @@
 where name = 'test_mode_pp';
 name | generic_plans | custom_plans
 --------------+---------------+--------------
-test_mode_pp | 3 | 6
+test_mode_pp | 0 | 0
 (1 row)
 
 drop table test_mode;
