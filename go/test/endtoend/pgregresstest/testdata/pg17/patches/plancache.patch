# Known divergence: SQL-level EXECUTE substitutes its arguments into the prepared
# body and runs plain SQL that PostgreSQL re-plans on every execution — there is
# no backend prepared statement or cached plan. So plancache observability
# diverges: EXECUTE after a result-shape DDL returns the new rows instead of
# "cached plan must not change result type", and plan_cache_mode /
# force_generic_plan is not observable because the arguments are inlined literals
# (a custom plan) rather than $N parameters. Query results are preserved.
--- a
+++ b
@@ -27,8 +27,12 @@
 DROP TABLE pcachetest;
 EXECUTE prepstmt;
 ERROR: relation "pcachetest" does not exist
+LINE 1: EXECUTE prepstmt;
+^
 EXECUTE prepstmt2(123);
 ERROR: relation "pcachetest" does not exist
+LINE 1: EXECUTE prepstmt2(123);
+^
 -- recreate the temp table (this demonstrates that the raw plan is
 -- purely textual and doesn't depend on OIDs, for instance)
 CREATE TEMP TABLE pcachetest AS SELECT * FROM int8_tbl ORDER BY 2;
@@ -53,9 +57,22 @@
 -- since clients probably aren't expecting that to change on the fly
 ALTER TABLE pcachetest ADD COLUMN q3 bigint;
 EXECUTE prepstmt;
-ERROR: cached plan must not change result type
+q1 | q2 | q3
+------------------+-------------------+----
+4567890123456789 | -4567890123456789 |
+4567890123456789 | 123 |
+123 | 456 |
+123 | 4567890123456789 |
+4567890123456789 | 4567890123456789 |
+(5 rows)
+
 EXECUTE prepstmt2(123);
-ERROR: cached plan must not change result type
+q1 | q2 | q3
+-----+------------------+----
+123 | 456 |
+123 | 4567890123456789 |
+(2 rows)
+
 -- but we're nice guys and will let you undo your mistake
 ALTER TABLE pcachetest DROP COLUMN q3;
 EXECUTE prepstmt;
@@ -287,9 +304,8 @@
 select name, generic_plans, custom_plans from pg_prepared_statements
 where name = 'test_mode_pp';
 name | generic_plans | custom_plans
---------------+---------------+--------------
-test_mode_pp | 0 | 0
-(1 row)
+------+---------------+--------------
+(0 rows)
 
