 set plan_cache_mode to force_generic_plan;
 explain (costs off) execute test_mode_pp(2);
 QUERY PLAN
------------------------------
+----------------------------------------------------------
 Aggregate
--> Seq Scan on test_mode
-Filter: (a = $1)
