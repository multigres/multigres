---------------+---------------+--------------
-test_mode_pp | 1 | 1
-(1 row)
+------+---------------+--------------
+(0 rows)
 
 -- get to generic plan by 5 executions
 set plan_cache_mode to auto;
@@ -354,9 +368,8 @@
