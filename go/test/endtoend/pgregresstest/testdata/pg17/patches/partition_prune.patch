# Known divergences (by design):
# - explain_parallel_append runs a dynamic EXECUTE the pooler cannot vet, so its
#   runtime CREATE is rejected. It is pre-seeded on the primary
#   (testdata/pg17/regress_preseed.sql) so the parallel-append plan checks run.
# - explain_parallel_append('execute ab_q4/ab_q5 ...') additionally fails: the
#   prepared statement is prepared on one pooled backend, but the seeded
#   function's dynamic EXECUTE runs on another that has not prepared it.
--- a
+++ b
@@ -2355,6 +2355,7 @@
 end loop;
 end;
 $$;
+ERROR: EXECUTE of a runtime-built statement inside a PL/pgSQL body is not supported: the statement text is not a constant, so it cannot be checked for unsafe session-state changes
 prepare ab_q4 (int, int) as
 select avg(a) from ab where a between $1 and $2 and b < 4;
 -- Encourage use of parallel plans
@@ -2363,81 +2364,21 @@
