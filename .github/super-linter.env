DEFAULT_BRANCH=main
# docs/migration/migrator_sql_interface.md is kept in Linear-friendly formatting
# (unwrapped paragraphs), which intentionally exceeds markdownlint MD013; excluded for now.
FILTER_REGEX_EXCLUDE=(external/.*)|(\.env$)|(demo/k8s/.*)|(.*\.tsbuildinfo$)|(.*\.pb\.go$)|(.*\.svg$)|(go\.sum$)|(docs/migration/migrator_sql_interface\.md$)
VALIDATE_CSS=false
VALIDATE_GO=false
VALIDATE_GO_MODULES=false
VALIDATE_JSCPD=false
VALIDATE_BIOME_FORMAT=false
VALIDATE_BIOME_LINT=false
VALIDATE_NATURAL_LANGUAGE=false
VALIDATE_PYTHON_RUFF_FORMAT=false
VALIDATE_JAVASCRIPT_ES=false
VALIDATE_JAVASCRIPT_STANDARD=false
VALIDATE_JSX=false
VALIDATE_TYPESCRIPT_ES=false
VALIDATE_TYPESCRIPT_STANDARD=false
VALIDATE_TSX=false
# SQL files in this repo are PostgreSQL test fixtures, not style-linted source;
# sqlfluff has no dialect configured, so linting them fails with "No dialect
# was specified". Disable it rather than impose a SQL style on test fixtures.
VALIDATE_SQLFLUFF=false
